# Copy to server/.env for local development.
# Never commit real secrets.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1

# PostgreSQL (Prisma)
# Prefer Supabase Session pooler (port 5432 on *.pooler.supabase.com) for app/Vercel —
# db.*.supabase.co is often IPv6-only and returns P1001 on Vercel.
# Encode special characters in the password (@ → %40).
DATABASE_URL=postgresql://postgres.acbhcdxvjpylmachdcnd:coldflow7865@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=1&connect_timeout=30
# Used by prisma migrate / introspect
DIRECT_URL=postgresql://postgres:coldflow7865@db.acbhcdxvjpylmachdcnd.supabase.co:5432/postgres?sslmode=require&connect_timeout=30

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
# SEED_FORCE=1

LOG_LEVEL=info
