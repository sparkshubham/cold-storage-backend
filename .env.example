# Copy to server/.env for local development.
# Never commit real secrets.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_PREFIX=/api/v1

# PostgreSQL (Prisma) — required.
# Encode special characters in the password (@ → %40, # → %23, / → %2F).
# Remote hosts get sslmode=require automatically if omitted.
DATABASE_URL=postgresql://postgres:coldflow7865@db.acbhcdxvjpylmachdcnd.supabase.co:5432/postgres?sslmode=require

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
# Set to 1 to wipe and recreate demo operational data on seed
# SEED_FORCE=1

LOG_LEVEL=info
