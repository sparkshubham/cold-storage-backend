NODE_ENV=development
PORT=5000
CLIENT_URL=https://cold-storage-five.vercel.app
# Comma-separated extra frontend origins. *.vercel.app is already allowed.
CORS_ORIGINS=https://cold-storage-five.vercel.app
API_PREFIX=/api/v1

# Required at Vercel build time so migrate + seed run during deploy.
#MONGODB_URI=mongodb://127.0.0.1:27017/coldflow
MONGODB_URI=mongodb+srv://cold-storage:coldstorage@cluster0.alxgtwk.mongodb.net/?appName=Cluster0

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

LOG_LEVEL=info
